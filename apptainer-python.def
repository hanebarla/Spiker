Bootstrap: docker
From: python:3.11-slim

%labels
    Author Spiker
    Description "Apptainer image for running Spiker Python workflows"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        ca-certificates
    rm -rf /var/lib/apt/lists/*

    python -m pip install --upgrade pip setuptools wheel
    python -m pip install \
        numpy \
        torch \
        snntorch \
        tabulate

%runscript
    exec python "$@"

%test
    python --version
    python -c "import torch, snntorch, numpy, tabulate; print('Imports OK')"
